# Copy to .env in the taskocalypse folder. Never commit .env.
APP_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1:8080
STATIC_DIR=dist
DATABASE_PATH=taskocalypse.db
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Optional for email/password accounts; required for Google sign-in and real Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for real account sign-in: Resend API key and an address on your verified sender domain.
# OTPs go to each user's email. Never use the user's Gmail password here.
OTP_API_KEY=
OTP_FROM=Taskocalypse <verify@your-verified-domain.example>
RUST_LOG=taskocalypse_server=info
